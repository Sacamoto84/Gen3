   65 00000000         
   66 00000000                 GBLA             RNDVAL
   67 00000000 02000000 
                       RNDVAL  SETA             (1 << ((32 - 12) + (6 - 1)))
   68 00000000         
   69 00000000         ; C64TOS - clip 64-bit accumulator to short (no rounding
                       )
   70 00000000         ;   xl, xh = value (lo 32, hi 32)
   71 00000000         ;   input assumed to have 6 fraction bits



ARM Macro Assembler    Page 3 


   72 00000000         ;   sign = temp variable to use for sign
   73 00000000         ;   maxPos = 0x00007fff (takes 2 instr. to generate - ca
                       lculating
   74 00000000         ;              once and using repeatedly saves if you do
                        several CTOS in a row)
   75 00000000                 MACRO
   76 00000000                 C64TOS           $xl, $xh, $sign, $maxPos
   77 00000000         
   78 00000000                 mov              $xl, $xl, lsr #(20+6)
   79 00000000                 orr              $xl, $xl, $xh, lsl #(12-6)
   80 00000000                 mov              $sign, $xl, ASR #31
   81 00000000                 cmp              $sign, $xl, ASR #15
   82 00000000                 eorne            $xl, $sign, $maxPos
   83 00000000         
   84 00000000                 MEND                         ; C64TOS
   85 00000000         
   86 00000000         ; MC0S - process 2 taps, 1 sample per channel (sample 0)
                       
   87 00000000         ;   x = vb1 offset
   88 00000000                 MACRO
   89 00000000                 MC0S             $x
   90 00000000         
   91 00000000                 ldr              CF1, [COEF], #4
   92 00000000                 ldr              CF2, [COEF], #4
   93 00000000                 ldr              VLO, [VB1, #(4*($x))]
   94 00000000                 ldr              VHI, [VB1, #(4*(23 - $x))]
   95 00000000         
   96 00000000                 smlal            SUM1LL, SUM1LH, VLO, CF1
   97 00000000                 ldr              VLO, [VB1, #(4*(32 + $x))]
   98 00000000                 rsb              CF2, CF2, #0
   99 00000000                 smlal            SUM1LL, SUM1LH, VHI, CF2
  100 00000000                 ldr              VHI, [VB1, #(4*(32 + 23 - $x))]
  101 00000000         
  102 00000000                 smlal            SUM1RL, SUM1RH, VLO, CF1
  103 00000000                 smlal            SUM1RL, SUM1RH, VHI, CF2
  104 00000000         
  105 00000000                 MEND                         ; MC0S
  106 00000000         
  107 00000000         ; MC1S - process 2 taps, 1 sample per channel (sample 16
                       )
  108 00000000         ;   x = vb1 offset
  109 00000000                 MACRO
  110 00000000                 MC1S             $x
  111 00000000         
  112 00000000                 ldr              CF1, [COEF], #4
  113 00000000                 ldr              VLO, [VB1, #(4*($x))]
  114 00000000                 ldr              VHI, [VB1, #(4*(32 + $x))]
  115 00000000                 smlal            SUM1LL, SUM1LH, VLO, CF1
  116 00000000                 smlal            SUM1RL, SUM1RH, VHI, CF1
  117 00000000         
  118 00000000                 MEND                         ; MC1S
  119 00000000         
  120 00000000         ; MC2S - process 2 taps, 2 samples per channel
  121 00000000         ;   x = vb1 offset
  122 00000000                 MACRO
  123 00000000                 MC2S             $x
  124 00000000         
  125 00000000         ; load data as far as possible in advance of using it
  126 00000000                 ldr              CF1, [COEF], #4



